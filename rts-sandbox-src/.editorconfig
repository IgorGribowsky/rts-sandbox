# Ставится install.js, в шаблон Unity не кладётся.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4
# Явные типы вместо var там, где тип не очевиден из правой части
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true

[*.{js,json,jsonc}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{unity,prefab,asset,mat,anim,controller,meta}]
# Сериализация Unity: не форматировать и не трогать пробелы
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset

[*.{ps1,bat,cmd}]
end_of_line = crlf
