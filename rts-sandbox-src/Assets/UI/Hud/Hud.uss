/* Layout and look of the in-game HUD. Values only through theme variables. */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: var(--font-display);
    color: var(--color-text);
}

.hud-text {
    -unity-text-outline-width: var(--text-outline);
    -unity-text-outline-color: var(--color-text-outline);
    text-shadow: 0 2px 2px var(--color-text-shadow);
}

/* --- top left: minimap and resources ------------------------------------ */

.hud-top-left {
    position: absolute;
    left: var(--edge);
    top: var(--edge);
    flex-direction: row;
    align-items: flex-start;
}

.minimap-slot {
    margin-right: var(--gap-m);
}

.minimap {
    border-radius: var(--radius-m);
    border-width: 3px;
    border-color: var(--color-rim);
    border-top-color: var(--color-rim-light);
    border-bottom-color: var(--color-rim-dark);
    background-color: var(--color-panel);
    overflow: hidden;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--tint-minimap-ground);
}

.minimap__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.resource-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 14px 4px 8px;
    border-radius: var(--radius-l);
    background-color: var(--color-panel-sunken);
    border-width: 1px;
    border-color: var(--color-hairline);
}

.resource-item {
    flex-direction: row;
    align-items: center;
    margin-right: var(--gap-l);
}

.resource-item:last-child {
    margin-right: 0;
}

.resource-icon {
    width: 44px;
    height: 44px;
    margin-right: var(--gap-s);
    -unity-background-scale-mode: scale-to-fit;
}

.resource-value {
    font-size: var(--text-l);
    -unity-text-align: middle-left;
    min-width: 40px;
    padding: 0;
    margin: 0;
}

.resource-value--bump {
    color: var(--color-accent);
}

/* --- bottom right: command ring ----------------------------------------- */

.hud-bottom-right {
    position: absolute;
    right: var(--edge);
    bottom: var(--edge);
}

/* Size of the ring's layout box; the parts are placed around its centre in code. */
.command-ring {
    width: 430px;
    height: 364px;
}

.gauge {
    --gauge-edge: var(--color-rim-dark);
}

.gauge--hp {
    --gauge-fill: var(--color-hp);
    --gauge-back: var(--color-hp-back);
}

.gauge--mana {
    --gauge-fill: var(--color-mana);
    --gauge-back: var(--color-mana-back);
}

.gauge--xp {
    --gauge-fill: var(--color-xp);
    --gauge-back: var(--color-xp-back);
}

.ring-value {
    font-size: var(--text-s);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    background-color: var(--color-panel);
    border-radius: var(--radius-m);
    border-width: var(--rim);
    border-color: var(--color-rim-dark);
}

.ring-value--hp {
    border-color: var(--color-hp);
}

.ring-value--mana {
    border-color: var(--color-mana);
}

.ring-value--xp {
    border-color: var(--color-xp);
}

/* --- ring buttons ---------------------------------------------------------- */

.ring-button {
    position: absolute;
    transition-property: scale;
    transition-duration: var(--release-duration);
    transition-timing-function: ease-out-back;
}

.ring-button:active {
    scale: var(--press-scale) var(--press-scale);
    transition-duration: var(--press-duration);
    transition-timing-function: ease-out;
}

.ring-button.is-inert:active {
    scale: 1 1;
}

.ring-button__glow {
    position: absolute;
    left: -9%;
    top: -9%;
    width: 118%;
    height: 118%;
    background-image: var(--img-glow);
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--fade-duration);
}

.ring-button:hover > .ring-button__glow {
    opacity: 0.3;
}

.ring-button.is-inert:hover > .ring-button__glow {
    opacity: 0;
}

.ring-button.is-pulsed > .ring-button__glow {
    opacity: 0.75;
}

.ring-button.is-active > .ring-button__glow {
    opacity: 1;
}

.ring-button__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ring-button--big > .ring-button__frame {
    background-image: var(--img-frame-big);
}

.ring-button--small > .ring-button__frame {
    background-image: var(--img-frame-small);
}

.ring-button__icon {
    position: absolute;
    left: 15%;
    top: 15%;
    width: 70%;
    height: 70%;
    -unity-background-scale-mode: scale-to-fit;
}

.ring-button__overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ring-attack > .ring-button__icon {
    left: 13%;
    top: 13%;
    width: 74%;
    height: 74%;
    background-image: var(--img-sword);
}

.ring-attack.is-placeholder > .ring-button__icon {
    background-image: var(--img-no-attack);
}

.ring-attack.is-placeholder > .ring-button__frame {
    -unity-background-image-tint-color: var(--tint-disabled);
}

.ring-hold > .ring-button__icon {
    background-image: var(--img-hold);
}

.ring-gather > .ring-button__icon {
    background-image: var(--img-gather);
}

.ring-button.is-unavailable > .ring-button__icon {
    -unity-background-image-tint-color: var(--tint-disabled);
}

.ring-button.is-unavailable > .ring-button__frame {
    -unity-background-image-tint-color: var(--tint-disabled);
}

/* --- skill buttons ---------------------------------------------------------- */

.ring-button--skill > .ring-button__frame {
    background-image: var(--img-frame-small);
}

.ring-button--skill > .ring-button__icon {
    left: 12%;
    top: 12%;
    width: 76%;
    height: 76%;
}

.ring-button--skill.is-no-mana > .ring-button__icon {
    -unity-background-image-tint-color: var(--tint-no-mana);
}

.ring-button--skill.is-cooldown > .ring-button__icon {
    -unity-background-image-tint-color: var(--tint-cooldown);
}

.ring-button--skill.is-passive > .ring-button__frame {
    -unity-background-image-tint-color: var(--tint-passive-frame);
}

.skill-sweep {
    position: absolute;
    left: 13%;
    top: 13%;
    width: 74%;
    height: 74%;
    --sweep-color: var(--color-sweep);
}

.skill-seconds {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: var(--text-l);
    color: var(--color-text);
}

.skill-key {
    position: absolute;
    right: -2px;
    bottom: -4px;
    min-width: 22px;
    height: 22px;
    padding: 0 4px;
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
    background-color: var(--color-panel);
    border-radius: var(--radius-s);
    border-width: 1px;
    border-color: var(--color-rim);
    color: var(--color-text);
}

/* --- tooltip ---------------------------------------------------------------- */

.tooltip {
    position: absolute;
    width: 330px;
    padding: 12px 14px 10px 14px;
    background-color: var(--color-panel);
    border-radius: var(--radius-m);
    border-width: var(--rim);
    border-color: var(--color-rim);
    border-top-color: var(--color-rim-light);
    border-bottom-color: var(--color-rim-dark);
}

.tooltip__title {
    font-size: var(--text-m);
    color: var(--color-accent);
    margin: 0;
    padding: 0;
}

.tooltip__kind {
    -unity-font-definition: var(--font-body-strong);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    margin: 2px 0 0 0;
    padding: 0;
}

.tooltip__description {
    -unity-font-definition: var(--font-body);
    font-size: var(--text-s);
    color: var(--color-text);
    white-space: normal;
    margin: 8px 0 0 0;
    padding: 0;
}

.tooltip__rows {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--color-hairline);
}

.tooltip__row {
    flex-direction: row;
    justify-content: space-between;
}

.tooltip__row-name {
    -unity-font-definition: var(--font-body);
    font-size: var(--text-s);
    color: var(--color-text-dim);
    margin: 0;
    padding: 1px 0;
}

.tooltip__row-value {
    font-size: var(--text-s);
    color: var(--color-text);
    margin: 0;
    padding: 1px 0;
}

/* --- level badge ------------------------------------------------------------ */

.level-badge {
    background-image: var(--img-badge-level);
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
    align-items: center;
}

.level-badge__value {
    font-size: var(--text-m);
    color: var(--color-accent);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* --- bottom left: build button and cards ------------------------------------ */

/* Ends where the command ring begins: the row never covers it. */
.hud-bottom-left {
    position: absolute;
    left: var(--edge);
    right: 470px;
    bottom: var(--edge);
    flex-direction: row;
    align-items: flex-end;
}

.build-button-slot {
    flex-shrink: 0;
}

.build-button {
    position: relative;
    width: 96px;
    height: 96px;
    margin-right: var(--gap-m);
}

.ring-button--build > .ring-button__frame {
    background-image: var(--img-frame-big);
}

.build-button > .ring-button__icon {
    background-image: var(--img-build);
}

.card-strip {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
}

.card-strip > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-direction: row;
    padding-top: 10px;
    padding-left: 8px;
}

.card {
    width: 116px;
    height: 160px;
    margin-right: var(--gap-m);
    padding: 6px;
    background-color: var(--color-panel);
    border-radius: var(--radius-m);
    border-width: var(--rim);
    border-color: var(--color-rim);
    border-top-color: var(--color-rim-light);
    border-bottom-color: var(--color-rim-dark);
    transition-property: scale, translate, border-color;
    transition-duration: var(--release-duration);
    transition-timing-function: ease-out-back;
}

.card:hover {
    translate: 0 -6px;
    border-color: var(--color-accent);
}

.card:active {
    scale: 0.93 0.93;
    transition-duration: var(--press-duration);
    transition-timing-function: ease-out;
}

.card.is-pulsed {
    border-color: var(--color-accent);
    background-color: var(--color-panel-raised);
}

.card__preview {
    height: 88px;
    border-radius: var(--radius-s);
    background-color: var(--color-panel-sunken);
    -unity-background-scale-mode: scale-to-fit;
}

.card.is-unaffordable > .card__preview {
    -unity-background-image-tint-color: var(--tint-cooldown);
}

.card__name {
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 4px 0 2px 0;
    padding: 0;
}

.card__costs {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.card__cost {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
}

.card__cost-icon {
    width: 20px;
    height: 20px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.card__cost-value {
    font-size: var(--text-xs);
    color: var(--color-text-cost-ok);
    margin: 0;
    padding: 0;
}

.card__cost-value.is-missing {
    color: var(--color-text-cost-missing);
}

.card__key {
    position: absolute;
    left: -6px;
    top: -8px;
    min-width: 24px;
    height: 24px;
    padding: 0 5px;
    font-size: var(--text-xs);
    -unity-text-align: middle-center;
    background-color: var(--color-panel);
    border-radius: var(--radius-s);
    border-width: 1px;
    border-color: var(--color-accent);
    color: var(--color-accent);
}

