/*
 * The one place where the interface style lives. Screen stylesheets only
 * refer to these variables: change a colour here and every element follows.
 * What the style is about, in words, is in .claude/docs/ui-style.md.
 */
:root {
    /* --- surfaces ------------------------------------------------------- */
    --color-panel: rgb(9, 14, 21);
    --color-panel-raised: rgb(24, 38, 52);
    --color-panel-sunken: rgba(6, 10, 16, 0.98);
    --color-rim: rgb(110, 147, 170);
    --color-rim-light: rgb(169, 202, 219);
    --color-rim-dark: rgb(4, 7, 11);
    --color-hairline: rgba(169, 202, 219, 0.24);

    /* --- accent: what is happening right now ----------------------------
       Ice cyan since 0.3.1 (T-065.1): the cold palette's one bright colour.
       Baked into glow_ring.png too, see Art/UI/make_icons.py. */
    --color-accent: rgb(79, 224, 255);
    --color-accent-soft: rgba(79, 224, 255, 0.35);
    --color-danger: rgb(255, 92, 84);

    /* --- text ----------------------------------------------------------- */
    --color-text: rgb(240, 246, 250);
    --color-text-dim: rgb(150, 172, 188);
    --color-text-outline: rgb(4, 7, 11);
    --color-text-shadow: rgba(0, 0, 0, 0.75);
    --color-text-cost-ok: rgb(232, 240, 245);
    --color-text-cost-missing: rgb(255, 120, 110);
    --color-text-income: rgb(196, 255, 150);

    /* --- characteristics ------------------------------------------------ */
    /* The uGUI bars over units (HPBar, ManaBar, ProcBar prefabs) repeat
       these colours as numbers: uGUI does not read USS. */
    --color-hp: rgb(232, 64, 70);
    --color-hp-back: rgba(70, 14, 18, 0.9);
    --color-mana: rgb(64, 146, 255);
    --color-mana-back: rgba(12, 28, 70, 0.9);
    --color-xp: rgb(246, 200, 72);
    --color-xp-back: rgba(64, 48, 8, 0.9);
    --color-gauge-shine: rgba(255, 255, 255, 0.3);

    /* --- icon states (multiplied into the picture) ---------------------- */
    --tint-normal: rgb(255, 255, 255);
    --tint-cooldown: rgb(150, 150, 150);
    --tint-no-mana: rgb(92, 120, 235);
    --tint-disabled: rgb(120, 120, 120);
    --tint-passive-frame: rgb(150, 178, 196);
    --color-sweep: rgba(4, 6, 12, 0.62);
    --color-progress-back: rgba(4, 6, 12, 0.7);
    /* Minimap (T-065.2): the white ground photo multiplied down to dark
       cold slate, the team dots in their own colours pop on it. */
    --tint-minimap-ground: rgb(88, 110, 124);
    --color-minimap-blocked: rgba(3, 6, 10, 0.86);
    --color-minimap-grid: rgba(169, 202, 219, 0.1);
    --color-minimap-view: rgb(240, 246, 250);
    --color-minimap-view-fill: rgba(240, 246, 250, 0.07);
    --color-minimap-dot-edge: rgba(2, 4, 8, 0.9);

    /* --- fonts ---------------------------------------------------------- */
    --font-display: url("project://database/Assets/UI/Fonts/RussoOne-Regular.ttf");
    --font-body: url("project://database/Assets/UI/Fonts/FiraSansCondensed-Medium.ttf");
    --font-body-strong: url("project://database/Assets/UI/Fonts/FiraSansCondensed-SemiBold.ttf");

    --text-xs: 15px;
    --text-s: 18px;
    --text-m: 22px;
    --text-l: 28px;
    --text-xl: 34px;
    --text-outline: 1.6px;
    --text-outline-thick: 2.4px;

    /* --- geometry ------------------------------------------------------- */
    --edge: 18px;
    --gap-s: 6px;
    --gap-m: 12px;
    --gap-l: 20px;
    --radius-s: 4px;
    --radius-m: 8px;
    --radius-l: 12px;
    --rim: 2px;
    --slot-current: 76px;
    --slot-waiting: 58px;

    /* --- pictures ------------------------------------------------------- */
    --img-frame-big: url("project://database/Assets/UI/Icons/frame_big.png");
    --img-frame-small: url("project://database/Assets/UI/Icons/frame_small.png");
    --img-glow: url("project://database/Assets/UI/Icons/glow_ring.png");
    --img-sword: url("project://database/Assets/UI/Icons/icon_sword.png");
    --img-no-attack: url("project://database/Assets/UI/Icons/icon_no_attack.png");
    --img-hold: url("project://database/Assets/UI/Icons/icon_hold.png");
    --img-gather: url("project://database/Assets/UI/Icons/icon_gather.png");
    --img-build: url("project://database/Assets/UI/Icons/icon_build.png");
    --img-badge-level: url("project://database/Assets/UI/Icons/badge_level.png");

    /* --- motion --------------------------------------------------------- */
    --press-scale: 0.9;
    --press-duration: 0.07s;
    --release-duration: 0.16s;
    --fade-duration: 0.12s;
    --slot-duration: 0.18s;
}
